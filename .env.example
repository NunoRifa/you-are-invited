# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (SQLite)
DATABASE_URL=storage/db/app.sqlite

# Security & Session
SESSION_SECRET=super-secret-session-key-change-in-production-min-32-chars

# File Storage
UPLOAD_DIR=storage/uploads

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudflare Turnstile (bot protection on guest wishes + admin login)
# Site key is public (served to the browser via /api/config/turnstile).
# Secret key is server-only — never expose it to the frontend or commit it.
# Get both from: Cloudflare Dashboard → Turnstile → your site.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Set to false to disable verification (emergency kill-switch).
TURNSTILE_ENABLED=true
