{
  "name": "you-are-invited",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "build": "npm --workspace=packages/shared-types run build && npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "db:seed": "npm --workspace=apps/api run db:seed",
    "db:verify": "node scripts/verify-db-wishes.cjs",
    "api:verify": "node scripts/verify-api.cjs",
    "browser:verify": "node scripts/verify-browser-wishes.cjs",
    "html:verify": "node scripts/verify-html-serving.cjs",
    "e2e:verify": "node scripts/verify-e2e-wishes.cjs",
    "client:create": "node scripts/create-client-invitation.cjs",
    "client:update-anggi-ivan": "node scripts/update-anggi-ivan.cjs",
    "admin:user": "node scripts/admin-user.cjs",
    "sections:verify": "node scripts/verify-post-comment-sections.cjs",
    "client:verify-revisions": "node scripts/verify-client-revisions.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
