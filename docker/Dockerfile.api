FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace and package manifests
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN npm ci --workspace=apps/api --workspace=packages/shared-types

# Copy source code
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api

# Build shared types and backend
RUN npm --workspace=packages/shared-types run build
RUN npm --workspace=apps/api run build

# Production runner
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm ci --omit=dev --workspace=apps/api --workspace=packages/shared-types

COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY apps/web/public/templates ./apps/api/pages/templates
COPY apps/web/public/production ./apps/api/pages/production
COPY scripts ./scripts

EXPOSE 3000

CMD ["node", "apps/api/dist/index.js"]
